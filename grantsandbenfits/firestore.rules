rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function owns(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isProfileCreate(data) {
      return data.keys().hasOnly(['displayName', 'email', 'createdAt', 'popiaConsent'])
        && data.displayName is string
        && data.displayName.size() > 1
        && data.displayName.size() <= 80
        && data.email == request.auth.token.email
        && data.popiaConsent == true
        && data.createdAt is timestamp;
    }

    match /users/{userId} {
      allow read: if owns(userId);
      allow create: if owns(userId) && isProfileCreate(request.resource.data);
      allow update: if owns(userId)
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['displayName', 'updatedAt'])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 1
        && request.resource.data.displayName.size() <= 80
        && request.resource.data.email == resource.data.email
        && request.resource.data.popiaConsent == resource.data.popiaConsent;
      allow delete: if false;
    }

    // Eligibility outcomes are not writable from the client.
    // An official decision is recorded by a trusted server path.
    match /applications/{applicationId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
